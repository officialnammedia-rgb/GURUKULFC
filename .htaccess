# Gurukul Football Academy - Apache / Hostinger Configuration
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ensure Authorization and Content-Type headers are passed to PHP scripts
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=CONTENT_TYPE:%{HTTP:Content-Type}]

  # Prevent Hostinger / Apache from overriding PHP JSON errors with HTML error templates
  ErrorDocument 400 default
  ErrorDocument 401 default
  ErrorDocument 403 default
  ErrorDocument 404 default
  ErrorDocument 405 default
  ErrorDocument 500 default

  # 1. API Endpoints routing to PHP
  RewriteRule ^api/create-order/?$ api/create-order.php [L,QSA]
  RewriteRule ^api/verify-payment/?$ api/verify-payment.php [L,QSA]

  # 2. Direct clean URL redirects (301 from .html to clean url)
  RewriteCond %{THE_REQUEST} /admin\.html [NC]
  RewriteRule ^admin\.html$ /admin [R=301,L]
  RewriteCond %{THE_REQUEST} /blog\.html [NC]
  RewriteRule ^blog\.html$ /blog [R=301,L]
  RewriteCond %{THE_REQUEST} /fees\.html [NC]
  RewriteRule ^fees\.html$ /fees [R=301,L]
  RewriteCond %{THE_REQUEST} /achievements\.html [NC]
  RewriteRule ^achievements\.html$ /achievements [R=301,L]
  RewriteCond %{THE_REQUEST} /coach\.html [NC]
  RewriteRule ^coach\.html$ /coach [R=301,L]

  # 3. Explicit page rewrites
  RewriteRule ^admin/?$ admin.html [L]
  RewriteRule ^blog/?$ blog.html [L]
  RewriteRule ^achievements/?$ achievements.html [L]
  RewriteRule ^player-achievements/?$ achievements.html [L]
  RewriteRule ^pay-fee/?$ fees.html [L]
  RewriteRule ^fees/?$ fees.html [L]
  RewriteRule ^coach/?$ coach.html [L]

  # 4. General clean HTML fallback
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L,QSA]
</IfModule>

# Security: Prevent direct web access to sensitive files
<FilesMatch "\.(env|log|git.*)$">
  Order allow,deny
  Deny from all
</FilesMatch>
